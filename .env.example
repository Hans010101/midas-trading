# 点金 Midas · 环境变量样板
# 使用:cp .env.example .env,然后改 SECRET_KEY 等敏感项
# .env 已在 .gitignore 中,不会提交到仓库

# ========== 应用 ==========
DEBUG=true

# ========== Postgres ==========
POSTGRES_DB=midas
POSTGRES_USER=midas
POSTGRES_PASSWORD=midas_dev

# 后端容器视角(docker compose 内部 DNS)
DATABASE_URL=postgresql+asyncpg://midas:midas_dev@postgres:5432/midas

# ========== ClickHouse ==========
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=midas
CLICKHOUSE_PASSWORD=midas_dev

# ========== Redis ==========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========== JWT(必填,生产强制更换)==========
SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== CORS(JSON 数组格式)==========
CORS_ORIGINS=["http://localhost:3000"]

# ========== Web 端(浏览器侧访问的 API URL)==========
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== AI 决策卡 · 0012 ADR M1 第二波 ==========
# 留空 → llm_mode='mock' · workflow 走假数据 · UI 可跑(等产品负责人填 key)
# 填了 → llm_mode='real' · 走 LiteLLM 真实调用 · 计入 ai_usage_log + ¥200/月预算
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MONTHLY_BUDGET_CNY=200
LLM_MOCK_MODE=false
