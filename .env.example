# 点金 Midas · 环境变量样板
# 使用:cp .env.example .env,然后改 SECRET_KEY 等敏感项
# .env 已在 .gitignore 中,不会提交到仓库

# ========== 应用 ==========
DEBUG=true

# ========== Postgres ==========
POSTGRES_DB=midas
POSTGRES_USER=midas
POSTGRES_PASSWORD=midas_dev

# 后端容器视角(docker compose 内部 DNS)
DATABASE_URL=postgresql+asyncpg://midas:midas_dev@postgres:5432/midas

# ========== ClickHouse ==========
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default

# ========== Redis ==========
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ========== JWT(必填,生产强制更换)==========
SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ========== CORS(JSON 数组格式)==========
CORS_ORIGINS=["http://localhost:3000"]

# ========== Web 端(浏览器侧访问的 API URL)==========
NEXT_PUBLIC_API_URL=http://localhost:8000
