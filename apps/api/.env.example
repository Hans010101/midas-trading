# 点金 Midas · API 本机直跑环境变量样板(不走 docker)
# 使用:cp .env.example .env

# 数据库走 localhost 而非 docker 内部 DNS
DATABASE_URL=postgresql+asyncpg://midas:midas_dev@localhost:5432/midas

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=midas
CLICKHOUSE_PASSWORD=midas_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1

# JWT(必填,无默认值,生产强制更换)
SECRET_KEY=REPLACE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS(JSON 数组格式)
CORS_ORIGINS=["http://localhost:3000"]

# 调试
DEBUG=true

# ===== AI 决策卡 · 0012 ADR M1 二波 =====
# 留空 → llm_mode='mock' · workflow 走假数据 · UI 可跑
# 填了 → llm_mode='real' · 走 LiteLLM 真实调用 · 计入 ai_usage_log
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek/deepseek-chat
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
LLM_MONTHLY_BUDGET_CNY=200
LLM_MOCK_MODE=false

# ===== Telegram 统一 bot · 0024 v2 · M1-G G1 =====
# 留空 → 统一 bot 未启用(/telegram/bind-token 返 503 · 不自动注册 webhook)· 旧 per-user 推送不受影响
# ⚠ TG_BOT_TOKEN 是敏感凭证:生产放服务器 /opt/midas/.env(跟 SECRET_KEY 同处)· 绝不进 git/前端/DB
TG_BOT_TOKEN=
# bot 用户名(拼 t.me deep link)· D9 待定 · 可留空(前端 G3 再补)
TG_BOT_USERNAME=
# 公网 API base · 拼 webhook 地址 · 生产 = https://api.midastrade.asia(prod compose 已注入,无需在此填)
PUBLIC_API_BASE_URL=http://localhost:8000
# 绑定 token 有效秒数(默认 10 分钟)
TG_BIND_TOKEN_TTL_SECONDS=600
# webhook secret 不在此配:由 SECRET_KEY 自动派生
