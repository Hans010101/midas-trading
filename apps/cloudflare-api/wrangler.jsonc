{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "midas-trading-api",
  "account_id": "a828bebda1f352216c7d7da425bad17a",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "routes": [
    {
      "pattern": "feishu-api.midastrade.asia",
      "custom_domain": true
    },
    {
      "pattern": "api.midastrade.asia",
      "custom_domain": true
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "PROJECT_NAME": "midas-trading",
    "API_VERSION": "v1",
    "PUBLIC_WEB_URL": "https://midastrade.asia",
    "EMAIL_FROM": "Midas Trading <noreply@midastrade.asia>",
    "GOOGLE_CLIENT_ID": "85423363850-6ot32sau6gffb9k4mgj9ish8bo6el8gu.apps.googleusercontent.com",
    "BINANCE_SQUARE_PUBLISH_MODE": "github",
    "ALIYUN_SMS_SIGN_NAME": "恒创联众",
    "ALIYUN_SMS_TEMPLATE_CODE": "100001"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midas-trading-db",
      "database_id": "a5557522-da75-4ced-b6c7-742bf6b2657b",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
