{
  "name": "@midas-trading/cloudflare-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "jose": "6.2.4"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types worker-configuration.d.ts --env-file .dev.vars.example --strict-vars=false",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .wrangler"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "typescript": "^5.7.0",
    "vite": "7.3.6",
    "vitest": "^4.1.0",
    "wrangler": "4.114.0"
  }
}
