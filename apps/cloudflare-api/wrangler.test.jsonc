{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "midas-trading-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "PROJECT_NAME": "midas-trading",
    "API_VERSION": "v1",
    "PUBLIC_WEB_URL": "https://web.example.test",
    "EMAIL_FROM": "Midas Trading <noreply@example.test>",
    "GOOGLE_CLIENT_ID": "test-google-client-id",
    "BINANCE_SQUARE_PUBLISH_MODE": "direct",
    "ALIYUN_SMS_SIGN_NAME": "Midas",
    "ALIYUN_SMS_TEMPLATE_CODE": "SMS_TEST"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "midas-trading-db-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
