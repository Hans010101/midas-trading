{
  "name": "midas-trading",
  "version": "0.1.0",
  "private": true,
  "description": "Midas Trading · 独立运行于 Cloudflare 的 AI 原生跨市场分析终端",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check:boundary": "node scripts/check-cloudflare-boundary.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
